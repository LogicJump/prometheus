{
  "name": "prometheus",
  "version": "0.1.0",
  "description": "A general-purpose terminal coding agent",
  "type": "module",
  "bin": {
    "prometheus": "./bin/prometheus.js"
  },
  "main": "desktop/main.js",
  "scripts": {
    "start": "node bin/prometheus.js",
    "desktop": "electron .",
    "build": "electron-builder --config electron-builder.json",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "agent",
    "cli",
    "coding",
    "openai"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}

# Local development

# Dependencies and build output
node_modules/
dist/

# Prometheus itself writes here: sessions, memory, audit log, model cache
.prometheus/

# Packaged builds (electron-builder). The glob covers the ad-hoc
# release-<name> directories that accumulate during testing.
release/
release*/

# Research dumps and scratch artefacts
.research/
*.log

# Ad-hoc source archives handed around during review
*.tar.gz
.env
models.json
argv.log
shot-*.png

# Per-machine agent/editor configuration
.claude/settings.local.json
.claude/launch.json

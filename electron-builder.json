{
  "appId": "dev.prometheus.desktop",
  "productName": "Prometheus",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "electronDist": "node_modules/electron/dist",
  "files": [
    "desktop/**/*",
    "src/**/*",
    "bin/**/*",
    "build/icon.png",
    "package.json",
    "README.md"
  ],
  "win": {
    "icon": "build/icon.png",
    "target": ["nsis", "portable"],
    "artifactName": "Prometheus-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}

{
  "appId": "dev.prometheus.desktop",
  "productName": "Prometheus",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "electronDist": "node_modules/electron/dist",
  "files": [
    "desktop/**/*",
    "src/**/*",
    "bin/**/*",
    "build/icon.png",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "win": {
    "icon": "build/icon.png",
    "target": ["nsis", "portable"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "Prometheus-${version}-${arch}-setup.${ext}"
  },
  "portable": {
    "artifactName": "Prometheus-${version}-${arch}-portable.${ext}"
  }
}

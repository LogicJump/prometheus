{
  "appId": "dev.prometheus.desktop",
  "productName": "Prometheus",
  "directories": {
    "output": "release2",
    "buildResources": "build"
  },
  "files": [
    "desktop/**/*",
    "src/**/*",
    "bin/**/*",
    "build/icon.png",
    "package.json",
    "README.md"
  ],
  "win": {
    "icon": "build/icon.png",
    "target": ["nsis", "portable"],
    "artifactName": "Prometheus-${version}-${arch}.${ext}"
  },
  "mac": {
    "icon": "build/icon.png",
    "target": ["dmg"],
    "category": "public.app-category.developer-tools"
  },
  "linux": {
    "icon": "build/icon.png",
    "target": ["AppImage", "deb"],
    "category": "Development"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
